{
  "name": "@nobla/rest-ui",
  "version": "1.0.1",
  "description": "Schema-driven UI components for REST projects",
  "license": "MIT",
  "type": "module",
  "main": "./dist/rest-ui.cjs",
  "module": "./dist/rest-ui.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/rest-ui.es.js",
      "require": "./dist/rest-ui.cjs"
    },
    "./style.css": "./dist/style.css",
    "./dist/style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "test": "node --test \"src/**/*.test.ts\"",
    "typecheck": "vue-tsc --noEmit"
  },
  "peerDependencies": {
    "@element-plus/icons-vue": "^2.3.0",
    "element-plus": "^2.12.0",
    "vue": "^3.3.0"
  },
  "dependencies": {
    "pluralize": "^8.0.0"
  },
  "devDependencies": {
    "@types/pluralize": "^0.0.33",
    "@vitejs/plugin-vue": "^5.0.0",
    "element-plus": "^2.12.0",
    "sass": "^1.99.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vite-plugin-dts": "^3.0.0",
    "vue": "^3.4.0",
    "vue-tsc": "^1.8.0"
  }
}
